---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Portfolio',
  description = 'Personal webpage — CV & portfolio of a software developer.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <!-- Skip to main content (a11y) -->
    <a class="skip-link" href="#main-content" data-i18n="a11y.skip_link">Skip to main content</a>

    <slot name="nav" />

    <main id="main-content">
      <slot />
    </main>

    <footer>
      <p class="text-center text-xs py-6" style="color:var(--muted)">
        <span aria-hidden="true" class="prompt">~/</span>
        <span data-i18n="footer.made_with">Built with Astro &amp; ♥</span>
      </p>
    </footer>

    <!-- i18n init: detect language and apply on first load -->
    <script>
      import { detectLang, setLang } from '../i18n/i18n';
      setLang(detectLang());
    </script>
  </body>
</html>
