---
// Contact.astro — email + social links
---

<section id="contact" aria-labelledby="contact-heading">
  <div class="section-inner">
    <h2 id="contact-heading" class="section-heading">
      <span aria-hidden="true" class="prompt">~/</span><span data-i18n="contact.section">contact</span>
    </h2>
    <p class="section-command" aria-hidden="true"><span data-i18n="contact.command">$ echo $CONTACT_INFO</span></p>

    <ul class="contact-list" role="list">
      <!-- Email -->
      <li role="listitem" class="contact-item">
        <span class="contact-label" data-i18n="contact.email">Email</span>
        <a href="mailto:fgpaolini@hotmail.com" class="contact-link">
          <!-- Email icon -->
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <polyline points="2,4 12,13 22,4"/>
          </svg>
          fgpaolini@hotmail.com
        </a>
      </li>

      <!-- GitHub -->
      <li role="listitem" class="contact-item">
        <span class="contact-label" data-i18n="contact.github">GitHub</span>
        <a href="https://github.com/fgpaolini" target="_blank" rel="noopener noreferrer" class="contact-link" aria-label="GitHub profile (opens in new tab)">
          <!-- GitHub icon -->
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.605-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          github.com/fgpaolini
        </a>
      </li>

      <!-- LinkedIn -->
      <li role="listitem" class="contact-item">
        <span class="contact-label" data-i18n="contact.linkedin">LinkedIn</span>
        <a href="https://www.linkedin.com/in/fernandogpaolini" target="_blank" rel="noopener noreferrer" class="contact-link" aria-label="LinkedIn profile (opens in new tab)">
          <!-- LinkedIn icon -->
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          linkedin.com/in/fernandogpaolini
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  #contact { padding: 5rem 1.5rem 8rem; }

  .section-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.875rem;
  }

  .contact-label {
    color: var(--muted);
    min-width: 70px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent);
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .contact-link:hover { opacity: 0.75; }
</style>
