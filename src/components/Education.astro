---
import { getCollection } from 'astro:content';

const entries = (await getCollection('education')).sort(
  (a, b) => (b.data.endYear ?? 9999) - (a.data.endYear ?? 9999)
);
---

<section id="education" aria-labelledby="education-heading">
  <div class="section-inner">
    <h2 id="education-heading" class="section-heading">
      <span aria-hidden="true" class="prompt">~/</span><span data-i18n="education.section">education</span>
    </h2>
    <p class="section-command" aria-hidden="true"><span data-i18n="education.command">$ cat education.log</span></p>

    <ol class="timeline" role="list">
      {entries.map((entry) => {
        const { institution, degree, degree_es, startYear, endYear } = entry.data;
        return (
          <li class="timeline-entry" role="listitem">
            <div class="timeline-dot" aria-hidden="true"></div>
            <div class="timeline-content">
              <div class="entry-header">
                <div>
                  <span class="entry-degree" data-i18n-en={degree} data-i18n-es={degree_es}>{degree}</span>
                  <span class="entry-institution"> @ {institution}</span>
                </div>
                <span class="entry-dates">{startYear} – {endYear ?? '…'}</span>
              </div>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<script>
  import { detectLang } from '../i18n/i18n';
  import type { Lang } from '../i18n/i18n';

  function applyDegrees(lang: Lang) {
    document.querySelectorAll<HTMLElement>('.entry-degree[data-i18n-en]').forEach((el) => {
      el.textContent = lang === 'es' ? el.dataset.i18nEs! : el.dataset.i18nEn!;
    });
  }

  applyDegrees(detectLang());

  document.addEventListener('langchange', (e: Event) => {
    applyDegrees((e as CustomEvent<Lang>).detail);
  });
</script>

<style>
  #education { padding: 5rem 1.5rem; }

  .section-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  /* Reuse timeline styles from Experience — defined in global via shared class names */
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 0;
    width: 1px;
    background: var(--border);
  }
  .timeline-entry {
    display: flex;
    gap: 1.25rem;
    padding-bottom: 2rem;
    position: relative;
  }
  .timeline-dot {
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    background: var(--bg);
    flex-shrink: 0;
    margin-top: 2px;
    position: relative;
    z-index: 1;
  }
  .timeline-content { flex: 1; }
  .entry-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .entry-degree {
    font-weight: 700;
    color: var(--text);
    font-size: 0.95rem;
  }
  .entry-institution {
    color: var(--accent);
    font-size: 0.9rem;
  }
  .entry-dates {
    font-size: 0.75rem;
    color: var(--muted);
    white-space: nowrap;
  }
</style>
